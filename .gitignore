# datasets and checkpoints live outside git (see README: Setup)
data/*
checkpoints/*

# python / editor / OS
__pycache__/
*.pyc
.DS_Store

# local assistant notes and settings (not part of the project)
claude.md
.claude/

# regenerable outputs (re-run the generator to rebuild)
# prediction cache from gen_qualitative.py (~135 MB)
resultData/qualitative/cache/
# framework-figure candidate panels from gen_qualitative.py (~250 MB)
resultData/qualitative/fig_framework/
# extra qualitative candidates from gen_qualitative.py --more_candidates
resultData/qualitative/more_candidates_*/
# framework-figure tiles from tools/make_figure_assets.py (~41 MB)
resultData/figure_assets/

# figure images from gen_qualitative.py (row panels, legends, previews, candidates)
resultData/qualitative/fig_qualitative/
resultData/qualitative/ignore_example.png
# reference screenshots of the paper's figures/tables (the .pptx and goal.txt stay tracked)
ref_images/**/*.png
# dated Figure A row sets from gen_qual_rows.py: images stay local, SELECTION.md / CSVs are tracked
resultData/qualitative/fig_qualitative_*/**/*.png
